#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks every skills/*/SKILL.md for valid frontmatter and the size cap, and
# every file under skills/ for words public copy must not contain.
# Standard library only, so CI runs it on a bare runner Ruby.

require "digest"
require "set"
require "yaml"

ROOT = File.expand_path("..", __dir__)
SKILLS = File.join(ROOT, "skills")

# Codex keeps only the first 8,000 bytes of a SKILL.md in Agent Plugins mode.
MAX_BYTES = 8000

# Strict Agent Plugins clients skip a skill whose frontmatter has other keys.
FRONTMATTER_KEYS = %w[name description license compatibility metadata allowed-tools].freeze

DENYLIST = [
  [/opentelemetry-native/i, %(says "OpenTelemetry-native"; say "OTLP-compatible")]
].freeze

# This repository is public, so it lists internal codenames only as SHA-256
# digests of the lowercased word, compared against every word in the copy.
CODENAME_DIGESTS = %w[
  475cd3ac40d8928e9a3d2145e2140be3846783637618cb7c6bb744eaddedbb50
  ae877628180e308b9e1d088eda3ca453dd4e5e80c8ff111f8b638f76b8a9ffc3
  2515f1dca74520b40ca45f2a0ee9f763671608642acfe62d57b5cebe61abd38e
  ac1d60c7093b207f5f2cc62f2d64da484e621b1096ff5bd131dbc92580b9edc5
  56ba6e515587a93ae85ada70b6b9b827a6cc45fda329834833ad5c89f6a2d62f
  c1d64b2d4cb30f1be788cc4d246ddd9fc1fe85a3eb3a85a3de33829dfaf6ce7d
].to_set.freeze

# Hostnames are checked by shape, so no internal one is written down: under
# logpacer.com only these are public, and no host has an "internal" label
# except Docker's own name for the host machine.
PUBLIC_HOSTS = %w[logpacer.com app.logpacer.com].freeze
DOCKER_HOST = "host.docker.internal"
HOSTNAME = /\b(?:[a-z0-9-]+\.)+[a-z][a-z0-9-]+\b/i

HELP = <<~HELP
  Usage: scripts/check-skills

  Checks each skills/<name>/SKILL.md:
    - YAML frontmatter with a name matching the directory and a description,
      using only the keys #{FRONTMATTER_KEYS.join(", ")}
    - at most #{MAX_BYTES} bytes
  and every file under skills/ against the public-copy denylist
  (internal codenames, internal hostnames and registries, "OpenTelemetry-native").

  Exits 1 and prints file: reason for every problem.

    -h, --help  show this help
HELP

def relative(path)
  path.delete_prefix("#{ROOT}/")
end

def frontmatter_problems(path, content)
  match = content.match(/\A---\r?\n(.*?)\r?\n---\r?\n/m) or return ["no YAML frontmatter"]
  frontmatter = YAML.safe_load(match[1])
  return ["frontmatter is not a mapping"] unless frontmatter.is_a?(Hash)

  directory = File.basename(File.dirname(path))
  problems = []
  problems << %(name #{frontmatter["name"].inspect} does not match directory "#{directory}") unless frontmatter["name"] == directory
  description = frontmatter["description"]
  problems << "no description" unless description.is_a?(String) && !description.strip.empty?
  (frontmatter.keys - FRONTMATTER_KEYS).each { |key| problems << "frontmatter key #{key.inspect} is not an Agent Skills field" }
  problems
rescue Psych::Exception => e
  ["frontmatter is not valid YAML (#{e.message})"]
end

def skill_problems(path)
  content = File.read(path)
  problems = frontmatter_problems(path, content)
  problems << "#{content.bytesize} bytes exceeds the #{MAX_BYTES}-byte limit" if content.bytesize > MAX_BYTES
  problems
end

def denylist_problems(path)
  content = File.binread(path)
  DENYLIST.filter_map { |pattern, reason| "#{reason} (#{content[pattern].inspect})" if content.match?(pattern) } +
    codename_problems(content) + hostname_problems(content)
end

def codename_problems(content)
  words = content.downcase.scan(/[a-z0-9_]+/).uniq
  words.select { |word| CODENAME_DIGESTS.include?(Digest::SHA256.hexdigest(word)) }
    .map { |word| "names an internal codename (#{word.inspect})" }
end

def hostname_problems(content)
  content.scan(HOSTNAME).map(&:downcase).uniq.filter_map do |host|
    labels = host.split(".")
    if labels.include?("internal") && host != DOCKER_HOST
      "names an internal hostname (#{host.inspect})"
    elsif (host == "logpacer.com" || host.end_with?(".logpacer.com")) && !PUBLIC_HOSTS.include?(host)
      "names a logpacer.com host that is not public (#{host.inspect})"
    end
  end
end

case ARGV
in []
in ["-h"] | ["--help"]
  puts HELP
  exit
else
  abort "✗ unknown arguments: #{ARGV.join(" ")}\n\n#{HELP}"
end

skill_files = Dir.glob(File.join(SKILLS, "*", "SKILL.md")).sort
all_files = Dir.glob(File.join(SKILLS, "**", "*"), File::FNM_DOTMATCH).select { |path| File.file?(path) }.sort

problems = skill_files.flat_map { |path| skill_problems(path).map { |reason| [path, reason] } } +
  all_files.flat_map { |path| denylist_problems(path).map { |reason| [path, reason] } }

if problems.empty?
  puts "✓ #{skill_files.size} skill(s) pass"
  exit
end

problems.each { |path, reason| puts "✗ #{relative(path)}: #{reason}" }
exit 1
